{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "./src",
        "allowJs": true,
        "target": "es2015",
        "module": "esnext",
        "jsx": "preserve",
        "isolatedModules": false,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true
    },
    "include": [
        "./src",
        "global.d.ts"
    ],
    "exclude": [
        "./src/__tests__"
    ]
}