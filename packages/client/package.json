        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.1.0",
        "webpack-manifest-plugin": "^6.0.1"
    },
    "scripts": {
        "start": "NODE_ENV=development webpack serve --config config/webpack.config.js --env development --port 3000 --stats minimal",
        "start:prod": "npm run build && serve -s build",
        "build": "NODE_ENV=production webpack --config config/webpack.config.js --env production --output-clean --stats minimal",
        "deploy": "gh-pages -d build",
        "lint": "eslint src --ext .ts,.tsx .",
        "precommit": "tsc --noEmit && lint-staged",
        "predeploy": "npm run build",
        "test": "jest",
        "typecheck": "tsc --noEmit"
    },
    "lint-staged": {
        "src/**/*.{ts,tsx}": [
            "pretty-quick --staged",
            "eslint --fix"
        ],
        "src/**/*.scss": [
            "stylelint --syntax=scss",
            "pretty-quick --staged"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
