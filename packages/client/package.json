        "eslint-loader": "3.0.3",
        "express": "^4.17.1",
        "file-loader": "4.3.0",
        "fs-extra": "^8.1.0",
        "gh-pages": "^3.0.0",
        "html-webpack-plugin": "^5.6.8",
