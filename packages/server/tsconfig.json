{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "rootDir": "./",
        "module": "esnext",
        "moduleResolution": "nodenext",
        "target": "esnext",
        "paths": {
            "~/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "./src"
    ],
    "exclude": [
        "./src/__tests__"
    ]
}