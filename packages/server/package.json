{
    "name": "@kerberjg-vscode-editor/server",
    "author": "Jamie Kerber <kerber.jg@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kerberjg/vscode-theme-editor.git"
    },
    "private": true,
    "homepage": "https://github.com/kerberjg/vscode-theme-editor#readme",
    "dependencies": {
        "@kerberjg-vscode-editor/semantic-tokens-utilities": "*",
        "body-parser": "^1.19.0",
        "express": "^4.17.1",
        "path": "^0.12.7",
        "typescript": "^3.9.6",
        "typescript-vscode-sh-plugin": "^0.6.14"
    },
    "devDependencies": {
        "@types/express": "^4.17.7",
        "@types/node": "^14.0.23",
        "@types/react": "^16.9.43",
        "ts-node-dev": "^1.0.0-pre.52",
        "tslib": "^2.0.0"
    },
    "type": "module",
    "scripts": {
        "watch": "ts-node-dev --respawn ./src/index.ts",
        "start": "ts-node-dev ./src/index.ts",
        "lint": "eslint src --ext .ts,.tsx .",
        "precommit": "tsc --noEmit && lint-staged",
        "typecheck": "tsc --noEmit"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "pretty-quick --staged"
        ]
    }
