{
    "name": "vscode-theme-editor",
    "version": "2.0.0",
    "main": "index.js",
    "repository": "https://github.com/kerberjg/vscode-theme-editor.git",
    "author": "Jamie Kerber <kerber.jg@gmail.com>",
    "license": "MIT",
    "workspaces": [
        "packages/*"
    ],
    "private": true,
    "scripts": {
        "start": "concurrently \"npm run build --workspace=@kerberjg-vscode-editor/textmate-utilities\" \"npm run build --workspace=@kerberjg-vscode-editor/semantic-tokens-utilities\" && npm run start:client",
        "build:textmate": "npm run build --workspace=@kerberjg-vscode-editor/textmate-utilities",
        "build:semantic": "npm run build --workspace=@kerberjg-vscode-editor/semantic-tokens-utilities",
        "watch": "concurrently \"npm run watch --workspace=@kerberjg-vscode-editor/textmate-utilities\" \"npm run watch --workspace=@kerberjg-vscode-editor/semantic-tokens-utilities\"",
        "start:client": "npm start --workspace=@kerberjg-vscode-editor/client",
        "deploy": "concurrently \"npm run build:textmate\" \"npm run build:semantic\" && npm run deploy --workspace=@kerberjg-vscode-editor/client",
        "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,scss,js,json}\""
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^2.10.0",
        "@typescript-eslint/parser": "^2.10.0",
        "babel-eslint": "10.1.0",
        "concurrently": "^5.2.0",
        "eslint": "6",
        "eslint-config-prettier": "^6.11.0",
        "eslint-config-react-app": "^5.2.1",
        "eslint-plugin-import": "2.20.1",
        "eslint-plugin-jsx-a11y": "6.2.3",
        "eslint-plugin-prettier": "^3.1.4",
        "eslint-plugin-react": "7.19.0",
        "eslint-plugin-react-hooks": "^1.6.1",
        "eslint-plugin-simple-import-sort": "^5.0.3",
        "lint-staged": "^10.2.11",
        "prettier": "^2.0.5",
        "pretty-quick": "^2.0.1",
        "stylelint": "^13.6.1",
        "stylelint-config-prettier": "^8.0.2",
        "stylelint-scss": "^3.18.0",
        "typescript": "3.9.6"
    },
    "dependencies": {}
}
